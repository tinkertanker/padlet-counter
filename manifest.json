{
  "manifest_version": 3,
  "name": "Section Counter for Padlet",
  "version": "1.3.0",
  "description": "Counts the posts in each Padlet section, or across a Wall, with a click-to-expand colour breakdown.",
  "homepage_url": "https://padlet-counter.tk.sg",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://padlet.com/*",
        "*://*.padlet.com/*",
        "*://padlet.org/*",
        "*://*.padlet.org/*"
      ],
      "js": ["src/counter.js"],
      "run_at": "document_idle"
    }
  ]
}
